rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mdrobiulislam34t@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPortalConfig(data) {
      return (!('brandName' in data) || (data.brandName is string && data.brandName.size() <= 100)) &&
        (!('brandSubtitle' in data) || (data.brandSubtitle is string && data.brandSubtitle.size() <= 150)) &&
        (!('qrImageUrl' in data) || (data.qrImageUrl is string && data.qrImageUrl.size() <= 2500000)) &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 3000000)) &&
        (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 200)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500000)) &&
        (!('qrMerchantName' in data) || (data.qrMerchantName is string && data.qrMerchantName.size() <= 100)) &&
        (!('qrMerchantId' in data) || (data.qrMerchantId is string && data.qrMerchantId.size() <= 64)) &&
        (!('videoTitle' in data) || (data.videoTitle is string && data.videoTitle.size() <= 120)) &&
        (!('videoBanglaDesc' in data) || (data.videoBanglaDesc is string && data.videoBanglaDesc.size() <= 500)) &&
        (!('supportPhone' in data) || (data.supportPhone is string && data.supportPhone.size() <= 30)) &&
        (!('supportTelegram' in data) || (data.supportTelegram is string && data.supportTelegram.size() <= 100));
    }

    // Portal Settings (e.g. portal_settings/config)
    match /portal_settings/{settingId} {
      allow get, list: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isValidPortalConfig(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Media & Assets
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(mediaId);
    }

    // Admins
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(adminUid);
    }
  }
}
